{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/instructions/global-identity.md",
    "~/.config/opencode/instructions/vessel-rules.md",
    "~/.config/opencode/instructions/vessel-frontend-rules.md"
  ],
  "model": "anthropic/luffy-ai",
  "small_model": "anthropic/luffy-ai",
  "agent": {
    "title": {
      "model": "anthropic/luffy-ai",
      "prompt": "为对话生成10个词以内且简洁明了的标题"
    },
    "compaction": {
      "model": "codex/gpt-5.2"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "luffy",
      "options": {
        "baseURL": "",
        "apiKey": ""
      },
      "models": {
        "luffy-ai": {
          "name": "luffy-ai",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "codex": {
      "npm": "@ai-sdk/openai",
      "name": "Codex",
      "options": {
        "baseURL": "https://code.newcli.com/codex/v1",
        "apiKey": "sk-ant-oat01-aLKr_y59KFhF6tG_aoMmURvnRJEzpPgFkW6uPX64tpbXaqj-EwVjN-Dlejx_AzY8g7GjCdo_VktU248TXJApH4uHvLiywAA"
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2",
          "limit": {
            "context": 160000,
            "output": 8192
          }
        },
        "gpt-5.2-codex": {
          "name": "GPT 5.2 Codex",
          "limit": {
            "context": 160000,
            "output": 8192
          }
        }
      }
    }
  },
  "plugin": [
    "oh-my-opencode@3.5.0",
    "@different-ai/opencode-browser"
  ],
  "lsp": false
}