# ============================================
# Vessel Preview Image (Hot Reload Dev Mode)
# ============================================
# 纯热部署镜像，源码通过 PVC 挂载
# node_modules 已在主镜像构建时安装到 /opt/node_modules

FROM node:20-slim

RUN apt-get update && apt-get install -y python3 python3-pip curl && rm -rf /var/lib/apt/lists/*

ENV NODE_PATH=/opt/node_modules \
    NODE_ENV=development

WORKDIR /workspace

EXPOSE 5173 3300

COPY scripts/start-backend.sh /usr/local/bin/start-backend.sh
RUN chmod +x /usr/local/bin/start-preview.sh

CMD ["/usr/local/bin/start-backend.sh"]
