# ============================================
# Vessel Preview Image
# ============================================
# 轻量级预览镜像，只包含前端静态资源

# ============================================
# Stage 1: Build Frontend
# ============================================
FROM node:20-slim AS builder

ARG VERSION=dev
ENV VITE_APP_VERSION=$VERSION
ENV VITE_IMAGE_NAME=vessel-preview

WORKDIR /build

RUN npm config set registry https://registry.npmmirror.com

COPY workspace/vessel-frontend/package.json workspace/vessel-frontend/package-lock.json ./

RUN npm ci

COPY workspace/vessel-frontend/ ./

RUN npm run build

# ============================================
# Stage 2: Nginx Server
# ============================================
FROM nginx:alpine

COPY --from=builder /build/dist /usr/share/nginx/html

COPY docker/nginx.preview.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
